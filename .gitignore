# 내 데이터 · 결과물 — 절대 올라가지 않는다
workspace/

# 토큰 · 비밀번호
.env
.env.*

# 내가 만든 스킬 (이름이 my- 로 시작) — 공유는 shared-rules/ 로만
.claude/skills/my-*/

# 내 컴퓨터 전용 설정 · 다른 도구가 만드는 폴더
.claude/settings.local.json
.omc/

# 실수로 둔 원본 파일
*.xlsx
.DS_Store

# 킷에 들어 있는 연습용 가짜 데이터는 올린다
# (상위 저장소가 *.csv 를 막아도 여기서 다시 연다 — 내 데이터는 workspace/ 라 계속 막힘)
!samples/
!samples/*.csv
